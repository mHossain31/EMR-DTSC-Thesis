<?xml version="1.0" encoding="UTF-8"?>
<!-- midtown: ready-to-run SUMO configuration (relative paths). Generated by `python -m nycemis net build`.
     The route file is the default demand; experiments pass their own route files and options. -->
<configuration>
    <input>
        <net-file value="midtown.net.xml.gz"/>
        <route-files value="midtown.default.rou.xml.gz"/>
    </input>
    <time>
        <begin value="0"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="300"/>
        <collision.action value="warn"/>
        <tls.actuated.jam-threshold value="30"/>
        <ignore-junction-blocker value="30"/>
    </processing>
    <random_number>
        <seed value="42"/>
    </random_number>
    <report>
        <no-step-log value="true"/>
        <duration-log.statistics value="true"/>
    </report>
    <gui_only>
        <gui-settings-file value="gui-settings.xml"/>
    </gui_only>
</configuration>
