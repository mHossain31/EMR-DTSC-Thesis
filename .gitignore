# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-carla/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Tools fetched locally (tectonic binary, caches)
tools/

# Legacy: the extracted 34 MB notebook (the zip is committed)
legacy/extracted/

# Data: the OSM extracts and built networks are committed (frozen inputs, hashes in data/MANIFEST.json);
# OpenDRIVE exports and route files are large and regenerated by the pipeline.
data/networks/**/*.xodr
data/demand/
data/cache/

# Results: raw per-run outputs are gitignored; summaries are committed
results/runs/
results/**/raw/
results/datasets/
*.xml.tmp

# Frames, scratch, OS
.DS_Store
Thumbs.db
*.log
!docs/*.log

# LaTeX build products
paper/build/
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc

# Frozen model binaries are reproducible from their train manifests (hashes recorded there); not committed.
models/**/*.joblib
models/**/compact/*.npy
models/smoke/
